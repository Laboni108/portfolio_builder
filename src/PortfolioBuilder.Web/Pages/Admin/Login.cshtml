@page
@model PortfolioBuilder.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="admin-page">
  <div class="container">
    <div class="section-label">Admin</div>
    <h1 class="section-title">Dashboard</h1>
    <p>Signed in as <strong>@Model.Username</strong>.</p>

    <div class="dashboard-cards">
      <a href="/Admin/Projects" class="stat-card">
        <div class="stat-card-num">@Model.ProjectCount</div>
        <div class="stat-card-label">Projects</div>
      </a>
      <a href="/Admin/Messages" class="stat-card">
        <div class="stat-card-num">@Model.UnreadCount</div>
        <div class="stat-card-label">Unread messages</div>
      </a>
    </div>
  </div>
</section>