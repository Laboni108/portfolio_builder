@page "{id:int}"
@model PortfolioBuilder.Web.Pages.Admin.Projects.EditModel
@{
    ViewData["Title"] = "Edit project";
}

<section class="admin-page">
  <div class="container">
    <div class="section-label">Admin</div>
    <h1 class="section-title">Edit project</h1>

    <form method="post" class="admin-form">
      <div class="form-group">
        <label class="form-label" asp-for="Input.Title">Title</label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="field-error"></span>
      </div>

      <div class="form-group">
        <label class="form-label" asp-for="Input.Description">Description</label>
        <textarea asp-for="Input.Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Input.Description" class="field-error"></span>
      </div>

      <div class="form-group">
        <label class="form-label" asp-for="Input.TechStack">Tech stack (separate with commas)</label>
        <input asp-for="Input.TechStack" class="form-control" />
        <span asp-validation-for="Input.TechStack" class="field-error"></span>
      </div>

      <div class="form-group">
        <label class="form-label" asp-for="Input.GithubUrl">GitHub link (optional)</label>
        <input asp-for="Input.GithubUrl" class="form-control" placeholder="https://github.com/..." />
        <span asp-validation-for="Input.GithubUrl" class="field-error"></span>
      </div>

      <div class="admin-form-actions">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-floppy-disk"></i> Save changes
        </button>
        <a href="/Admin/Projects" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</section>