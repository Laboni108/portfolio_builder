@page
@model PortfolioBuilder.Web.Pages.Admin.Messages.IndexModel
@{
    ViewData["Title"] = "Messages";
}

<section class="admin-page">
  <div class="container">
    <div class="section-label">Admin</div>
    <h1 class="section-title">Messages</h1>
    <p>@Model.UnreadCount unread of @Model.Items.Count total.</p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
      <div class="form-success">@Model.StatusMessage</div>
    }

    @if (Model.Items.Count == 0)
    {
      <p>No messages yet.</p>
    }
    else
    {
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Status</th>
              <th>From</th>
              <th>Subject</th>
              <th>Received</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var message in Model.Items)
            {
              <tr class="@(message.IsRead ? "" : "row-unread")">
                <td>
                  @if (message.IsRead)
                  {
                    <span class="badge-read">Read</span>
                  }
                  else
                  {
                    <span class="badge-new">New</span>
                  }
                </td>
                <td>
                  @message.Name<br />
                  <small>@message.Email</small>
                </td>
                <td>@(string.IsNullOrWhiteSpace(message.Subject) ? "(no subject)" : message.Subject)</td>
                <td>@message.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="admin-actions">
                  <a href="/Admin/Messages/Details?id=@message.Id">Open</a>
                  <form method="post" asp-page-handler="Delete" asp-route-id="@message.Id"
                        onsubmit="return confirm('Delete this message?');">
                    <button type="submit" class="admin-delete">Delete</button>
                  </form>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</section>