@page
@model PortfolioBuilder.Web.Pages.SetupModel
@{
    ViewData["Title"] = "Create admin";
}

<section class="admin-login">
  <div class="container">
    <div class="login-card">
      <div class="section-label">Setup</div>
      <h1 class="section-title">Create admin</h1>

      <form method="post">
        <div class="form-group">
          <label class="form-label" asp-for="Input.Username">Username</label>
          <input asp-for="Input.Username" class="form-control" autocomplete="username" />
          <span asp-validation-for="Input.Username" class="field-error"></span>
        </div>

        <div class="form-group">
          <label class="form-label" asp-for="Input.Password">Password</label>
          <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
          <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>

        <div class="form-group">
          <label class="form-label" asp-for="Input.ConfirmPassword">Repeat password</label>
          <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
          <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary">
          <i class="fas fa-user-plus"></i> Create admin
        </button>
      </form>
    </div>
  </div>
</section>