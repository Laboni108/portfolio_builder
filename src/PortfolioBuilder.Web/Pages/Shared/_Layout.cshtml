<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Laboni Rahman</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/portfolio.css" asp-append-version="true" />
</head>
<body>

    <!-- NAVIGATION -->
    <nav id="navbar">
        <div class="nav-inner">
            <a href="/#hero" class="nav-logo">LR<span>.</span></a>
            <ul class="nav-links">
                <li><a href="/#about">About</a></li>
                <li><a href="/#education">Education</a></li>
                <li><a href="/#skills">Skills</a></li>
                <li><a href="/#projects">Projects</a></li>
                <li><a href="/#competitive">Coding</a></li>
                <li><a href="/#contact">Contact</a></li>
                <li><a href="/Admin" class="nav-admin">Admin</a></li>
            </ul>
            <div class="hamburger" id="hamburger">
                <span></span><span></span><span></span>
            </div>
        </div>
    </nav>

    <!-- MOBILE NAV -->
    <div class="nav-mobile" id="navMobile">
        <a href="/#about">About</a>
        <a href="/#education">Education</a>
        <a href="/#skills">Skills</a>
        <a href="/#projects">Projects</a>
        <a href="/#competitive">Coding Skills</a>
        <a href="/#contact">Contact</a>
        <a href="/Admin">Admin</a>
    </div>

    @RenderBody()

    <!-- FOOTER -->
    <footer>
        <div class="footer-inner">
            <a href="/#hero" class="footer-logo">Laboni Rahman<span>.</span></a>
            <p class="footer-copy">&copy; @DateTime.Now.Year Laboni Rahman. All rights reserved.</p>
            <div class="footer-socials">
                <a href="https://www.linkedin.com/in/laboni-rahman-ab5277316/" target="_blank" class="social-link">
                    <i class="fab fa-linkedin-in"></i>
                </a>
                <a href="https://github.com/Laboni108" target="_blank" class="social-link">
                    <i class="fab fa-github"></i>
                </a>
                <a href="mailto:laboni.rahman.a3@gmail.com" class="social-link">
                    <i class="fas fa-envelope"></i>
                </a>
            </div>
        </div>
    </footer>

    <!-- SCROLL TOP -->
    <a href="/#hero" class="scroll-top" id="scrollTop">
        <i class="fas fa-arrow-up"></i>
    </a>

    <script src="~/js/portfolio.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
